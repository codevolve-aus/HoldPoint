rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function roleDoc() { return firestore.get(/databases/(default)/documents/roles/$(request.auth.token.email.lower())); }
    function hasRole() { return signedIn() && firestore.exists(/databases/(default)/documents/roles/$(request.auth.token.email.lower())); }
    function isRole(r) { return hasRole() && roleDoc().data.role == r; }

    // Photos taken on site by supervisors, one folder per QF record.
    match /photos/{recordId}/{file} {
      allow read: if hasRole();
      allow create: if isRole('supervisor') && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // The same folders as SharePoint:
    // Projects/Year/Client/Job Project/QA/Project Documents | Completed Documents | Submitted Documents
    match /Projects/{path=**} {
      allow read: if hasRole();
      allow create: if isRole('engineer') && request.resource.size < 50 * 1024 * 1024
                    && (request.resource.contentType == 'application/pdf'
                        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
  }
}
