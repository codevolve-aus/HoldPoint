rules_version = '2';
// Access is by role. Roles live in /roles/{email}; only an admin can change them.
// Supervisors only ever see their own region.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/roles/$(myEmail())); }
    function me() { return get(/databases/$(database)/documents/roles/$(myEmail())).data; }
    function isRole(r) { return hasRole() && me().role == r; }
    // Admins must sign in with Google. Temporary test passwords are for engineers and supervisors only.
    function isAdmin() { return isRole('admin') && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isEngineer() { return isRole('engineer'); }
    function inMyRegion(region) { return isRole('supervisor') && region == me().region; }
    function projectRegion(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data.region; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /roles/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin() || isEngineer());
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    // Year › Client › Project. Engineers set projects up; supervisors see their region's.
    match /projects/{pid} {
      allow read: if isEngineer() || isAdmin() || inMyRegion(resource.data.region);
      allow create, update, delete: if isEngineer();

      // ITP revisions. Drafts are engineer-only until approved and released.
      match /revisions/{rid} {
        allow read: if isEngineer() || isAdmin()
                    || (inMyRegion(resource.data.region) && resource.data.status in ['live', 'superseded']);
        allow create, update: if isEngineer() && request.resource.data.region == projectRegion(pid);
        allow delete: if isEngineer() && resource.data.status == 'draft';
      }

      // Sign / Date on each ITP line, and the sign-on table. Signed on the supervisor's tablet or the engineer's laptop.
      match /signoffs/{sid} {
        allow read: if isEngineer() || isAdmin() || inMyRegion(resource.data.region);
        allow create, update: if (isEngineer() || inMyRegion(request.resource.data.region))
                              && request.resource.data.region == projectRegion(pid);
      }
    }

    // QF records: one copy of a QF form per ITP line.
    match /records/{id} {
      allow read: if isEngineer() || isAdmin() || inMyRegion(resource.data.region);
      allow create: if inMyRegion(request.resource.data.region) && request.resource.data.status == 'draft'
                    && request.resource.data.region == projectRegion(request.resource.data.projectId);
      allow update: if (inMyRegion(resource.data.region) && resource.data.status in ['draft', 'returned']
                         && request.resource.data.status in ['draft', 'returned', 'submitted']
                         && request.resource.data.region == resource.data.region)
                    || (isEngineer() && resource.data.status == 'submitted'
                         && request.resource.data.status in ['submitted', 'approved', 'returned'])
                    // Filing an approved form in a client pack changes nothing else.
                    || (isEngineer() && resource.data.status == 'approved' && request.resource.data.status == 'approved'
                         && onlyChanged(['packId', 'packName', 'history']))
                    // Admin rollback of an approval, entries untouched.
                    || (isAdmin() && resource.data.status == 'approved' && request.resource.data.status == 'submitted'
                         && request.resource.data.values == resource.data.values);
      allow delete: if inMyRegion(resource.data.region) && resource.data.status == 'draft';
    }

    // Client packs (Submitted Documents).
    match /packs/{id} {
      allow read: if isEngineer() || isAdmin() || inMyRegion(resource.data.region);
      allow create: if isEngineer();
    }

    match /audit/{id} {
      allow read: if isAdmin() || isEngineer();
      allow create: if hasRole() && request.resource.data.byEmail == myEmail();
    }
  }
}
